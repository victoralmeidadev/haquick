{
  "name": "haquick",
  "version": "0.1.1",
  "description": "Design system universal: Radix + CSS na web, StyleSheet no React Native.",
  "license": "MIT",
  "author": "Victor Almeida",
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "ui",
    "components",
    "cross-platform",
    "radix-ui",
    "universal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victoralmeidadev/haquick.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/victoralmeidadev/haquick#readme",
  "bugs": {
    "url": "https://github.com/victoralmeidadev/haquick/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.78",
    "@gorhom/bottom-sheet": ">=5",
    "react-native-gesture-handler": ">=2.20",
    "react-native-reanimated": ">=4",
    "react-native-worklets": ">=0.5"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-table": "^8.21.2"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.1.1",
    "@storybook/react": "8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "jsdom": "^30.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-worklets": "^0.10.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./web": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js",
        "require": "./dist/web/index.cjs"
      },
      "./native": {
        "types": "./dist/native/index.d.ts",
        "import": "./dist/native/index.js",
        "require": "./dist/native/index.cjs"
      },
      "./tokens": {
        "types": "./dist/tokens/index.d.ts",
        "import": "./dist/tokens/index.js",
        "require": "./dist/tokens/index.cjs"
      },
      "./styles.css": "./dist/web/index.css",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
